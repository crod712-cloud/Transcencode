<UserControl x:Class="HandBrakeWPF.Views.TranscencodeUpscaleView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             MinWidth="720" MinHeight="430">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="10">
            <Border BorderBrush="#6E7781" BorderThickness="1" CornerRadius="4" Padding="12" Margin="0,0,0,12">
                <StackPanel>
                    <TextBlock Text="Upscale &amp; Enhance" FontSize="18" FontWeight="SemiBold"/>
                    <TextBlock Margin="0,4,0,0" TextWrapping="Wrap"
                               Text="This tab changes HandBrake's real Dimensions settings. Same as source preserves the original resolution. A larger target enables HandBrake's standard scaler."/>
                    <TextBlock Margin="0,5,0,0" TextWrapping="Wrap" Foreground="DimGray"
                               Text="RTX Video Super Resolution is not falsely labeled as a permanent-file encoder feature here. NVIDIA AI upscaling requires a separate RTX Video SDK processing path."/>
                </StackPanel>
            </Border>

            <Grid Margin="0,0,0,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="180"/>
                    <ColumnDefinition Width="270"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Grid.Column="0" Text="Source resolution" FontWeight="SemiBold" Margin="0,5"/>
                <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding SourceResolution}" Margin="0,5"/>

                <TextBlock Grid.Row="1" Grid.Column="0" Text="Target resolution" FontWeight="SemiBold" Margin="0,5"/>
                <ComboBox Grid.Row="1" Grid.Column="1" ItemsSource="{Binding TargetChoices}" SelectedItem="{Binding SelectedTarget}" Margin="0,3"/>

                <TextBlock Grid.Row="2" Grid.Column="0" Text="Maximum width" FontWeight="SemiBold" Margin="0,5"/>
                <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding TargetWidth, UpdateSourceTrigger=PropertyChanged}" Margin="0,3"/>

                <TextBlock Grid.Row="3" Grid.Column="0" Text="Maximum height" FontWeight="SemiBold" Margin="0,5"/>
                <TextBox Grid.Row="3" Grid.Column="1" Text="{Binding TargetHeight, UpdateSourceTrigger=PropertyChanged}" Margin="0,3"/>

                <CheckBox Grid.Row="4" Grid.Column="1" Content="Preserve source aspect ratio" IsChecked="{Binding PreserveAspectRatio}" Margin="0,8,0,0"/>
            </Grid>

            <StackPanel Orientation="Horizontal">
                <Button Content="Apply to HandBrake Dimensions" Command="{Binding ApplyCommand}" Padding="14,7"/>
                <Button Content="Same as Source" Command="{Binding KeepSourceCommand}" Padding="14,7" Margin="8,0,0,0"/>
            </StackPanel>

            <Border Background="#12000000" CornerRadius="4" Padding="10" Margin="0,12,0,0">
                <TextBlock Text="{Binding Status}" TextWrapping="Wrap"/>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
