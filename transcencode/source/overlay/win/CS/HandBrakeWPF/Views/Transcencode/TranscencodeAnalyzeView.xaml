<UserControl x:Class="HandBrakeWPF.Views.TranscencodeAnalyzeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             MinWidth="720" MinHeight="430">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" BorderBrush="#6E7781" BorderThickness="1" CornerRadius="4" Padding="12" Margin="0,0,0,10">
            <StackPanel>
                <TextBlock Text="Deep Analyze" FontSize="18" FontWeight="SemiBold"/>
                <TextBlock Margin="0,4,0,0" TextWrapping="Wrap"
                           Text="This is separate from HandBrake's ordinary source scan. It inspects representative pictures for shadows, brightness, contrast, fine detail, and scene-to-scene variation, then recommends a source-specific constant-quality starting point."/>
                <TextBlock Margin="0,5,0,0" Foreground="DimGray" TextWrapping="Wrap"
                           Text="This first native milestone analyzes HandBrake's retained preview samples. Temporal motion analysis and automated test-encode scoring are not claimed yet."/>
            </StackPanel>
        </Border>

        <Grid Grid.Row="1" Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Button Grid.Column="0" Content="Run Deep Analyze" Command="{Binding AnalyzeCommand}" IsEnabled="{Binding CanAnalyze}" Padding="16,7"/>
            <Button Grid.Column="1" Content="Apply Recommendation to Video Tab" Command="{Binding ApplyRecommendationCommand}" IsEnabled="{Binding HasRecommendation}" Padding="16,7" Margin="8,0,0,0"/>
            <TextBlock Grid.Column="2" Text="{Binding Status}" Margin="12,6,0,0" TextWrapping="Wrap"/>
        </Grid>

        <Grid Grid.Row="2" Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Border Grid.Column="0" Background="#12000000" CornerRadius="4" Padding="10" Margin="0,0,5,0">
                <StackPanel>
                    <TextBlock Text="What was inspected" FontWeight="SemiBold"/>
                    <TextBlock Text="{Binding Coverage}" TextWrapping="Wrap" Margin="0,4,0,0"/>
                    <TextBlock Text="{Binding Findings}" TextWrapping="Wrap" Margin="0,6,0,0"/>
                </StackPanel>
            </Border>
            <Border Grid.Column="1" Background="#12000000" CornerRadius="4" Padding="10" Margin="5,0,0,0">
                <StackPanel>
                    <TextBlock Text="Recommendation" FontWeight="SemiBold"/>
                    <TextBlock Text="{Binding Recommendation}" TextWrapping="Wrap" Margin="0,4,0,0"/>
                </StackPanel>
            </Border>
        </Grid>

        <DataGrid Grid.Row="3" ItemsSource="{Binding Samples}" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False">
            <DataGrid.Columns>
                <DataGridTextColumn Header="#" Binding="{Binding Sample}" Width="40"/>
                <DataGridTextColumn Header="Approx. time" Binding="{Binding ApproximateTime}" Width="95"/>
                <DataGridTextColumn Header="Brightness" Binding="{Binding Brightness}" Width="85"/>
                <DataGridTextColumn Header="Dark pixels" Binding="{Binding DarkPixels}" Width="85"/>
                <DataGridTextColumn Header="Contrast" Binding="{Binding Contrast}" Width="80"/>
                <DataGridTextColumn Header="Detail" Binding="{Binding Detail}" Width="75"/>
                <DataGridTextColumn Header="Scene variation" Binding="{Binding SceneVariation}" Width="105"/>
                <DataGridTextColumn Header="Encoding difficulty" Binding="{Binding Difficulty}" Width="*"/>
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</UserControl>
