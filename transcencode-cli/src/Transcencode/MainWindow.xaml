<Window x:Class="Transcencode.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Transcencode — Analyze. Encode. Verify."
        Width="1420" Height="920" MinWidth="1040" MinHeight="720"
        WindowStartupLocation="CenterScreen"
        Loaded="Window_Loaded" Closing="Window_Closing">
    <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
        <Grid x:Name="ScaleRoot" Margin="18" MinWidth="980">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Margin="0,0,0,14">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="Transcencode" FontSize="32" FontWeight="SemiBold" />
                    <TextBlock Text="Analyze. Encode. Verify." FontSize="16" Foreground="{StaticResource AccentBrush}" />
                </StackPanel>
                <Border Grid.Column="1" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource PanelBorderBrush}" BorderThickness="1" CornerRadius="5" Padding="12,8">
                    <StackPanel Orientation="Horizontal">
                        <Ellipse x:Name="EngineStatusLight" Width="12" Height="12" Fill="{StaticResource WarningBrush}" Margin="0,0,8,0" />
                        <TextBlock x:Name="EngineStatusText" Text="Checking HandBrakeCLI…" VerticalAlignment="Center" />
                    </StackPanel>
                </Border>
            </Grid>

            <Border Grid.Row="1" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource PanelBorderBrush}" BorderThickness="1" CornerRadius="6" Padding="12" Margin="0,0,0,12">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="105" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Row="0" Grid.Column="0" Text="Source file" VerticalAlignment="Center" FontWeight="SemiBold" />
                    <TextBox x:Name="SourcePathTextBox" Grid.Row="0" Grid.Column="1" VerticalContentAlignment="Center" TextChanged="SourcePathTextBox_TextChanged" />
                    <Button Grid.Row="0" Grid.Column="2" Content="Browse…" Click="BrowseSource_Click" MinWidth="95" />
                    <Button x:Name="ScanButton" Grid.Row="0" Grid.Column="3" Content="Scan File Details" Click="Scan_Click" MinWidth="145" ToolTip="Reads source metadata, video properties, audio tracks, subtitle tracks, HDR flags, and crop estimates. This is not the deeper compression sample analysis." />

                    <TextBlock Grid.Row="1" Grid.Column="0" Text="Output file" VerticalAlignment="Center" FontWeight="SemiBold" />
                    <TextBox x:Name="OutputPathTextBox" Grid.Row="1" Grid.Column="1" VerticalContentAlignment="Center" TextChanged="OptionChanged" />
                    <Button Grid.Row="1" Grid.Column="2" Content="Browse…" Click="BrowseOutput_Click" MinWidth="95" />
                    <StackPanel Grid.Row="1" Grid.Column="3" Orientation="Horizontal">
                        <Button x:Name="EncodeButton" Content="Encode Now" Click="Encode_Click" MinWidth="115" FontWeight="SemiBold" />
                        <Button x:Name="CancelButton" Content="Cancel" Click="Cancel_Click" MinWidth="80" IsEnabled="False" />
                    </StackPanel>
                </Grid>
            </Border>

            <Border Grid.Row="2" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource PanelBorderBrush}" BorderThickness="1" CornerRadius="6" Padding="12" Margin="0,0,0,12">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="100" />
                        <ColumnDefinition Width="125" />
                        <ColumnDefinition Width="145" />
                        <ColumnDefinition Width="185" />
                    </Grid.ColumnDefinitions>
                    <ProgressBar x:Name="EncodeProgressBar" Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="5" Height="18" Minimum="0" Maximum="100" />
                    <TextBlock x:Name="StatusText" Grid.Row="1" Grid.Column="0" Text="Ready" Margin="2,7,12,0" />
                    <TextBlock x:Name="PercentText" Grid.Row="1" Grid.Column="1" Text="0.0%" Margin="2,7,12,0" HorizontalAlignment="Right" />
                    <TextBlock x:Name="FpsText" Grid.Row="1" Grid.Column="2" Text="FPS: —" Margin="2,7,12,0" HorizontalAlignment="Right" />
                    <TextBlock x:Name="EtaText" Grid.Row="1" Grid.Column="3" Text="Remaining: —" Margin="2,7,12,0" HorizontalAlignment="Right" />
                    <TextBlock x:Name="FinishText" Grid.Row="1" Grid.Column="4" Text="Finish: —" Margin="2,7,2,0" HorizontalAlignment="Right" />
                </Grid>
            </Border>

            <TabControl x:Name="MainTabs" Grid.Row="3" MinHeight="520" SelectionChanged="MainTabs_SelectionChanged">
                <TabItem Header="Source Details">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="16">
                            <TextBlock Text="Quick source scan" FontSize="22" FontWeight="SemiBold" />
                            <TextBlock Text="This reads file details and available tracks. It does not claim to inspect dark scenes or perform a visual-quality comparison." Foreground="{StaticResource MutedTextBrush}" Margin="0,4,0,16" />
                            <GroupBox Header="Source summary">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="160" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <TextBlock Grid.Row="0" Text="File" FontWeight="SemiBold" Margin="0,4" />
                                    <TextBlock x:Name="SourceFileText" Grid.Row="0" Grid.Column="1" Text="No source scanned" Margin="0,4" />
                                    <TextBlock Grid.Row="1" Text="Duration" FontWeight="SemiBold" Margin="0,4" />
                                    <TextBlock x:Name="SourceDurationText" Grid.Row="1" Grid.Column="1" Text="—" Margin="0,4" />
                                    <TextBlock Grid.Row="2" Text="Resolution" FontWeight="SemiBold" Margin="0,4" />
                                    <TextBlock x:Name="SourceResolutionText" Grid.Row="2" Grid.Column="1" Text="—" Margin="0,4" />
                                    <TextBlock Grid.Row="3" Text="Video codec" FontWeight="SemiBold" Margin="0,4" />
                                    <TextBlock x:Name="SourceCodecText" Grid.Row="3" Grid.Column="1" Text="—" Margin="0,4" />
                                    <TextBlock Grid.Row="4" Text="Frame rate" FontWeight="SemiBold" Margin="0,4" />
                                    <TextBlock x:Name="SourceFrameRateText" Grid.Row="4" Grid.Column="1" Text="—" Margin="0,4" />
                                    <TextBlock Grid.Row="5" Text="HDR / Dolby Vision" FontWeight="SemiBold" Margin="0,4" />
                                    <TextBlock x:Name="SourceHdrText" Grid.Row="5" Grid.Column="1" Text="—" Margin="0,4" />
                                    <TextBlock Grid.Row="6" Text="Detected crop" FontWeight="SemiBold" Margin="0,4" />
                                    <TextBlock x:Name="SourceCropText" Grid.Row="6" Grid.Column="1" Text="—" Margin="0,4" />
                                </Grid>
                            </GroupBox>
                            <TextBlock x:Name="TrackSummaryText" Text="Audio and subtitle tracks will appear on the Tracks tab after the scan." Foreground="{StaticResource MutedTextBrush}" />
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>

                <TabItem Header="Encode">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <Grid Margin="16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Margin="0,0,10,0">
                                <GroupBox Header="Video encoder">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="155" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>
                                        <TextBlock Grid.Row="0" Text="Encoder" VerticalAlignment="Center" />
                                        <ComboBox x:Name="EncoderCombo" Grid.Row="0" Grid.Column="1" SelectionChanged="EncoderChanged" />
                                        <TextBlock Grid.Row="1" Text="Quality profile" VerticalAlignment="Center" />
                                        <ComboBox x:Name="QualityProfileCombo" Grid.Row="1" Grid.Column="1" SelectionChanged="QualityProfileChanged" />
                                        <TextBlock Grid.Row="2" Text="CQ / RF value" VerticalAlignment="Center" />
                                        <TextBox x:Name="QualityValueTextBox" Grid.Row="2" Grid.Column="1" Text="16" TextChanged="OptionChanged" />
                                        <TextBlock Grid.Row="3" Text="Encoder speed" VerticalAlignment="Center" />
                                        <ComboBox x:Name="EncoderPresetCombo" Grid.Row="3" Grid.Column="1" SelectionChanged="OptionChanged">
                                            <ComboBoxItem Content="Default" IsSelected="True" />
                                            <ComboBoxItem Content="slowest" />
                                            <ComboBoxItem Content="slower" />
                                            <ComboBoxItem Content="slow" />
                                            <ComboBoxItem Content="medium" />
                                            <ComboBoxItem Content="fast" />
                                            <ComboBoxItem Content="faster" />
                                        </ComboBox>
                                    </Grid>
                                </GroupBox>
                                <Border Background="#202B36" BorderBrush="{StaticResource PanelBorderBrush}" BorderThickness="1" CornerRadius="5" Padding="12" Margin="0,0,0,12">
                                    <StackPanel>
                                        <TextBlock x:Name="QualityExplanationText" FontWeight="SemiBold" Text="Lower CQ/RF numbers increase quality and file size." />
                                        <TextBlock Text="NVENC constant quality is not automatically mathematically lossless. The visually transparent profile is intended to look extremely close to the source without falsely claiming bit-for-bit losslessness." Foreground="{StaticResource MutedTextBrush}" Margin="0,6,0,0" />
                                    </StackPanel>
                                </Border>
                                <GroupBox Header="Track and chapter handling">
                                    <StackPanel>
                                        <CheckBox x:Name="PreserveAudioCheckBox" Content="Keep all audio tracks when the output container supports them" IsChecked="True" Checked="OptionChanged" Unchecked="OptionChanged" />
                                        <CheckBox x:Name="PreserveSubtitlesCheckBox" Content="Keep all subtitle tracks when the output container supports them" IsChecked="True" Checked="OptionChanged" Unchecked="OptionChanged" />
                                        <CheckBox x:Name="ChapterMarkersCheckBox" Content="Keep chapter markers" IsChecked="True" Checked="OptionChanged" Unchecked="OptionChanged" />
                                        <CheckBox x:Name="WebOptimizeCheckBox" Content="Web optimize MP4 output" Checked="OptionChanged" Unchecked="OptionChanged" />
                                    </StackPanel>
                                </GroupBox>
                            </StackPanel>

                            <StackPanel Grid.Column="1" Margin="10,0,0,0">
                                <GroupBox Header="What Transcencode will run">
                                    <TextBox x:Name="CommandPreviewTextBox" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="230" FontFamily="Consolas" FontSize="12" VerticalScrollBarVisibility="Auto" />
                                </GroupBox>
                                <Border Background="#202B36" BorderBrush="{StaticResource PanelBorderBrush}" BorderThickness="1" CornerRadius="5" Padding="12">
                                    <StackPanel>
                                        <TextBlock Text="NVIDIA RTX 2080 Ti guidance" FontWeight="SemiBold" />
                                        <TextBlock Text="Use H.265 10-bit (NVIDIA NVENC) for efficient high-quality HEVC output. The RTX 2080 Ti supports H.264 and HEVC NVENC, including 10-bit HEVC, but not AV1 hardware encoding." Foreground="{StaticResource MutedTextBrush}" Margin="0,6,0,0" />
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </Grid>
                    </ScrollViewer>
                </TabItem>

                <TabItem Header="Tracks">
                    <Grid Margin="16">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <TextBlock Text="Audio available in the source" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,8" />
                        <DataGrid x:Name="AudioGrid" Grid.Row="1" AlternationCount="2" MinHeight="170">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="#" Binding="{Binding Track}" Width="50" />
                                <DataGridTextColumn Header="Language" Binding="{Binding Language}" Width="150" />
                                <DataGridTextColumn Header="Code" Binding="{Binding LanguageCode}" Width="75" />
                                <DataGridTextColumn Header="Codec" Binding="{Binding Codec}" Width="150" />
                                <DataGridTextColumn Header="Channels" Binding="{Binding Channels}" Width="130" />
                                <DataGridTextColumn Header="Bitrate" Binding="{Binding BitRate}" Width="110" />
                                <DataGridTextColumn Header="Sample rate" Binding="{Binding SampleRate}" Width="110" />
                                <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="*" />
                            </DataGrid.Columns>
                        </DataGrid>
                        <TextBlock Grid.Row="2" Text="Subtitles available in the source" FontSize="18" FontWeight="SemiBold" Margin="0,14,0,8" />
                        <DataGrid x:Name="SubtitleGrid" Grid.Row="3" AlternationCount="2" MinHeight="170">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="#" Binding="{Binding Track}" Width="50" />
                                <DataGridTextColumn Header="Language" Binding="{Binding Language}" Width="150" />
                                <DataGridTextColumn Header="Code" Binding="{Binding LanguageCode}" Width="75" />
                                <DataGridTextColumn Header="Type" Binding="{Binding Type}" Width="180" />
                                <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="*" />
                                <DataGridTextColumn Header="Capabilities" Binding="{Binding Capabilities}" Width="180" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </TabItem>

                <TabItem Header="Picture &amp; Scale">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <Grid Margin="16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Margin="0,0,10,0">
                                <GroupBox Header="Black bars and cropping">
                                    <StackPanel>
                                        <TextBlock Text="Black-bar handling" FontWeight="SemiBold" />
                                        <ComboBox x:Name="CropModeCombo" SelectionChanged="CropModeChanged">
                                            <ComboBoxItem Content="Same as source — preserve original frame and black bars" IsSelected="True" />
                                            <ComboBoxItem Content="Safe auto crop — least aggressive removal" />
                                            <ComboBoxItem Content="Automatic crop — remove detected black bars" />
                                            <ComboBoxItem Content="Custom crop" />
                                        </ComboBox>
                                        <TextBlock x:Name="CropExplanationText" Text="No pixels are cropped. The encoded frame keeps the same black bars as the source." Foreground="{StaticResource MutedTextBrush}" Margin="4,4,4,10" />
                                        <Grid x:Name="CustomCropPanel" IsEnabled="False">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="80" />
                                                <ColumnDefinition Width="90" />
                                                <ColumnDefinition Width="80" />
                                                <ColumnDefinition Width="90" />
                                            </Grid.ColumnDefinitions>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                            </Grid.RowDefinitions>
                                            <TextBlock Grid.Row="0" Grid.Column="0" Text="Top" VerticalAlignment="Center" />
                                            <TextBox x:Name="CropTopTextBox" Grid.Row="0" Grid.Column="1" Text="0" TextChanged="OptionChanged" />
                                            <TextBlock Grid.Row="0" Grid.Column="2" Text="Bottom" VerticalAlignment="Center" />
                                            <TextBox x:Name="CropBottomTextBox" Grid.Row="0" Grid.Column="3" Text="0" TextChanged="OptionChanged" />
                                            <TextBlock Grid.Row="1" Grid.Column="0" Text="Left" VerticalAlignment="Center" />
                                            <TextBox x:Name="CropLeftTextBox" Grid.Row="1" Grid.Column="1" Text="0" TextChanged="OptionChanged" />
                                            <TextBlock Grid.Row="1" Grid.Column="2" Text="Right" VerticalAlignment="Center" />
                                            <TextBox x:Name="CropRightTextBox" Grid.Row="1" Grid.Column="3" Text="0" TextChanged="OptionChanged" />
                                        </Grid>
                                    </StackPanel>
                                </GroupBox>
                            </StackPanel>

                            <StackPanel Grid.Column="1" Margin="10,0,0,0">
                                <GroupBox Header="Resolution and upscaling">
                                    <StackPanel>
                                        <TextBlock Text="Output size" FontWeight="SemiBold" />
                                        <ComboBox x:Name="ScaleModeCombo" SelectionChanged="ScaleModeChanged">
                                            <ComboBoxItem Content="Same as source — no resizing" IsSelected="True" />
                                            <ComboBoxItem Content="1080p — 1920 × 1080" />
                                            <ComboBoxItem Content="1440p — 2560 × 1440" />
                                            <ComboBoxItem Content="4K — 3840 × 2160" />
                                            <ComboBoxItem Content="Custom size" />
                                        </ComboBox>
                                        <TextBlock x:Name="ScaleExplanationText" Text="Keeps the source resolution. No upscaling or downscaling is requested." Foreground="{StaticResource MutedTextBrush}" Margin="4,4,4,10" />
                                        <Grid x:Name="CustomScalePanel" IsEnabled="False">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="80" />
                                                <ColumnDefinition Width="110" />
                                                <ColumnDefinition Width="80" />
                                                <ColumnDefinition Width="110" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="Width" VerticalAlignment="Center" />
                                            <TextBox x:Name="CustomWidthTextBox" Grid.Column="1" Text="1920" TextChanged="OptionChanged" />
                                            <TextBlock Grid.Column="2" Text="Height" VerticalAlignment="Center" />
                                            <TextBox x:Name="CustomHeightTextBox" Grid.Column="3" Text="1080" TextChanged="OptionChanged" />
                                        </Grid>
                                    </StackPanel>
                                </GroupBox>
                                <Border Background="#202B36" BorderBrush="{StaticResource PanelBorderBrush}" BorderThickness="1" CornerRadius="5" Padding="12">
                                    <StackPanel>
                                        <TextBlock Text="What this upscaling is" FontWeight="SemiBold" />
                                        <TextBlock Text="This uses HandBrake's normal software scaling filters. It can resize video on a system with an RTX 2080 Ti, but it is not NVIDIA RTX Video Super Resolution or a trained AI restoration model." Foreground="{StaticResource MutedTextBrush}" Margin="0,6,0,0" />
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </Grid>
                    </ScrollViewer>
                </TabItem>

                <TabItem Header="Analyze">
                    <Grid Margin="16">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <TextBlock Text="Compression sample analysis" FontSize="22" FontWeight="SemiBold" />
                        <TextBlock Grid.Row="1" Text="This beta analysis performs short hidden HandBrakeCLI encodes at representative points through the source and compares how much bitrate each sample needs at the selected constant-quality setting. It measures relative compression difficulty. It does not yet claim to measure scene brightness, grain, VMAF, SSIM, or full visual losslessness." Foreground="{StaticResource MutedTextBrush}" Margin="0,4,0,12" />
                        <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,0,0,10">
                            <Button x:Name="RunSampleAnalysisButton" Content="Run Compression Sample Analysis" Click="RunSampleAnalysis_Click" MinWidth="230" />
                            <Button x:Name="CancelAnalysisButton" Content="Cancel" Click="Cancel_Click" MinWidth="80" IsEnabled="False" />
                            <TextBlock x:Name="AnalysisStatusText" Text="Scan a source first." VerticalAlignment="Center" Margin="12,0,0,0" />
                        </StackPanel>
                        <DataGrid x:Name="AnalysisGrid" Grid.Row="3" AlternationCount="2" MinHeight="260">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Sample" Binding="{Binding Sample}" Width="70" />
                                <DataGridTextColumn Header="Start time" Binding="{Binding Start}" Width="130" />
                                <DataGridTextColumn Header="Size (MB)" Binding="{Binding Megabytes, StringFormat=0.00}" Width="110" />
                                <DataGridTextColumn Header="Approx. Mbps" Binding="{Binding MegabitsPerSecond, StringFormat=0.00}" Width="130" />
                                <DataGridTextColumn Header="Average FPS" Binding="{Binding AverageFps, StringFormat=0.0}" Width="120" />
                                <DataGridTextColumn Header="Relative difficulty" Binding="{Binding RelativeDifficulty}" Width="*" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </TabItem>

                <TabItem Header="Verify">
                    <Grid Margin="16">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <TextBlock Text="Verify encoded output" FontSize="22" FontWeight="SemiBold" />
                        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,8,0,12">
                            <Button x:Name="VerifyButton" Content="Verify Output File" Click="Verify_Click" MinWidth="150" />
                            <TextBlock x:Name="VerificationSummaryText" Text="No output has been verified." VerticalAlignment="Center" Margin="12,0,0,0" />
                        </StackPanel>
                        <DataGrid x:Name="VerificationGrid" Grid.Row="2" AlternationCount="2" MinHeight="300">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Check" Binding="{Binding Check}" Width="180" />
                                <DataGridTextColumn Header="Result" Binding="{Binding Result}" Width="110" />
                                <DataGridTextColumn Header="Details" Binding="{Binding Details}" Width="*" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </TabItem>

                <TabItem Header="Live Engine">
                    <Grid Margin="12">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                            <TextBlock Text="Embedded HandBrakeCLI output" FontSize="18" FontWeight="SemiBold" VerticalAlignment="Center" />
                            <Button Content="Clear" Click="ClearConsole_Click" Margin="14,0,0,0" />
                            <Button Content="Copy All" Click="CopyConsole_Click" />
                        </StackPanel>
                        <TextBox x:Name="ConsoleTextBox" Grid.Row="1" IsReadOnly="True" AcceptsReturn="True" TextWrapping="NoWrap" FontFamily="Consolas" FontSize="12" Background="#090B0D" Foreground="#D8E1EA" BorderBrush="{StaticResource PanelBorderBrush}" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" />
                    </Grid>
                </TabItem>

                <TabItem Header="Options">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="16">
                            <GroupBox Header="Interface size">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="210" />
                                        <ColumnDefinition Width="220" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Scale the entire interface" VerticalAlignment="Center" />
                                    <ComboBox x:Name="InterfaceScaleCombo" Grid.Column="1" SelectionChanged="InterfaceScaleChanged">
                                        <ComboBoxItem Content="100%" Tag="1.0" IsSelected="True" />
                                        <ComboBoxItem Content="110%" Tag="1.1" />
                                        <ComboBoxItem Content="125%" Tag="1.25" />
                                        <ComboBoxItem Content="150%" Tag="1.5" />
                                        <ComboBoxItem Content="175%" Tag="1.75" />
                                        <ComboBoxItem Content="200%" Tag="2.0" />
                                    </ComboBox>
                                    <TextBlock Grid.Column="2" Text="The window becomes scrollable when the scaled content is larger than the monitor." Foreground="{StaticResource MutedTextBrush}" VerticalAlignment="Center" Margin="12,0,0,0" />
                                </Grid>
                            </GroupBox>
                            <GroupBox Header="Encoding behavior">
                                <StackPanel>
                                    <CheckBox x:Name="ShowConsoleCheckBox" Content="Open the Live Engine tab automatically when encoding starts" IsChecked="True" Checked="SettingChanged" Unchecked="SettingChanged" />
                                    <CheckBox x:Name="VerifyAfterEncodeCheckBox" Content="Run structural verification automatically after a successful encode" IsChecked="True" Checked="SettingChanged" Unchecked="SettingChanged" />
                                    <CheckBox x:Name="OpenFolderCheckBox" Content="Open the output folder after a successful encode" Checked="SettingChanged" Unchecked="SettingChanged" />
                                </StackPanel>
                            </GroupBox>
                            <GroupBox Header="Engine and diagnostics">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="170" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <TextBlock Grid.Row="0" Text="Engine path" FontWeight="SemiBold" Margin="0,4" />
                                    <TextBlock x:Name="EnginePathText" Grid.Row="0" Grid.Column="1" Margin="0,4" />
                                    <TextBlock Grid.Row="1" Text="Engine version" FontWeight="SemiBold" Margin="0,4" />
                                    <TextBlock x:Name="EngineVersionText" Grid.Row="1" Grid.Column="1" Text="Checking…" Margin="0,4" />
                                    <TextBlock Grid.Row="2" Text="Diagnostic logs" FontWeight="SemiBold" Margin="0,4" />
                                    <TextBlock x:Name="DiagnosticPathText" Grid.Row="2" Grid.Column="1" Margin="0,4" />
                                </Grid>
                            </GroupBox>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>
            </TabControl>

            <TextBlock Grid.Row="4" Text="Transcencode CLI stabilization build — the encoding engine runs hidden; its output stays inside this window." Foreground="{StaticResource MutedTextBrush}" Margin="2,10,0,0" />
        </Grid>
    </ScrollViewer>
</Window>
